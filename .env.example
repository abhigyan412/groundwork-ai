# Copy to .env and fill in. Never commit .env.

# --- Database ---
# Local dev uses the compose `db` service on host port 5433 (5432 is often taken by a local Postgres).
# Inside Docker Compose the api service overrides this to point at db:5432.
DATABASE_URL=postgresql://groundwork:groundwork@localhost:5433/groundwork
# Used by pytest only. The tests TRUNCATE this database, so its name must end in _test.
TEST_DATABASE_URL=postgresql://groundwork:groundwork@localhost:5433/groundwork_test

# --- Admin auth ---
# At least 32 characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=480

# --- Assistant token ---
# Fernet key used to keep an encrypted copy of the assistant token so the dashboard can show the
# link again (ADR 0007). Lookups still use the SHA-256 hash.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ASSISTANT_TOKEN_KEY=

# Base URL visitors use; assistant links are built as {PUBLIC_BASE_URL}/a/{token}
PUBLIC_BASE_URL=http://localhost:8080

# --- Storage ---
# Private PDF storage, never served publicly. Files land at {STORAGE_DIR}/{org_id}/{document_id}.pdf
STORAGE_DIR=storage

# --- LLM (used only by the decompose step and compose()) ---
# Supported providers:
#   gemini    = Google Gemini (demo default; free-tier key from https://aistudio.google.com/apikey)
#   anthropic = Claude
#   fake      = no network: no decisions, extractive answers (tests, offline dev)
LLM_PROVIDER=gemini
# Leave empty to fall back to the SDK's own variable (GEMINI_API_KEY / ANTHROPIC_API_KEY).
LLM_API_KEY=
# Empty = provider default: gemini-3.6-flash (gemini) or claude-sonnet-5-5 (anthropic).
# Alternatives: gemini-3.8-flash, claude-opus-5-5.
LLM_MODEL=
# Thinking depth: Anthropic effort / Gemini 3.x thinking_level (low, medium, high).
LLM_EFFORT_DECOMPOSE=medium
LLM_EFFORT_COMPOSE=low
LLM_TIMEOUT_SECONDS=60
# Anthropic SDK retries (408/409/429/5xx).
LLM_MAX_RETRIES=2
# Our retry with exponential backoff on 429/5xx (Gemini free tier: ~5-10 requests per minute).
LLM_RATE_LIMIT_RETRIES=4
LLM_RETRY_BASE_SECONDS=2
LLM_RETRY_MAX_WAIT_SECONDS=45

# --- Local models (System 1) ---
# local = load real models (downloaded to the Hugging Face cache on first start); fake = tests only
MODEL_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
NLI_MODEL=cross-encoder/nli-deberta-v3-small
